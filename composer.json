{
    "name": "muxi/muxi-php",
    "description": "MUXI PHP SDK - Manage AI agent formations and interact with their runtime APIs",
    "type": "library",
    "license": "MIT",
    "keywords": ["muxi", "ai", "sdk", "agents", "formations"],
    "homepage": "https://github.com/muxi-ai/muxi-php",
    "authors": [
        {
            "name": "MUXI AI",
            "email": "support@muxi.ai"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Muxi\\": "src/"
        },
        "classmap": [
            "src/Errors.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Muxi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src/",
        "analyze": "phpstan analyse src/ --level=5"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
